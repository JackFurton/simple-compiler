// Control flow example: while loops, if-else, modulo, and nested blocks

let n = 20;
let evens = 0;
let odds = 0;
let i = 1;

while (i <= n) {
    if (i % 2 == 0) {
        evens = evens + 1;
    } else {
        odds = odds + 1;
    }
    i = i + 1;
}

print "Total numbers checked: " + str(n);
print "Evens count: " + str(evens);
print "Odds count: " + str(odds);

// Block scoping demonstration
let outer = "outside";
{
    let inner = "inside";
    print "Inside block: " + inner + ", " + outer;
}
print "Outside block again: " + outer;
