// Standard Library Demo: Math, Strings, and File I/O

print "=== Math Demo ===";
print "PI = " + str(PI);
print "E  = " + str(E);
print "sqrt(144) = " + str(sqrt(144));
print "max(25, 42) = " + str(max(25, 42));
print "round(PI, 4) = " + str(round(PI, 4));

print "";
print "=== String Utilities Demo ===";
let sentence = "  compiler engineering is fun and educational  ";
let cleaned = trim(sentence);
print "Trimmed: '" + cleaned + "'";
print "Upper: " + to_upper(cleaned);

let words = split(cleaned, " ");
print "Word count: " + str(len(words));
print "Hyphenated: " + join(words, "-");

print "";
print "=== File I/O Demo ===";
let test_file = "examples/demo_output.txt";
write_file(test_file, "Generated by simple-compiler!\n");
append_file(test_file, "Second line of text.\n");

let content = read_file(test_file);
print "File content read successfully (" + str(len(content)) + " chars):";
print content;

remove_file(test_file);
print "Temporary file cleaned up. Exists? " + str(file_exists(test_file));
